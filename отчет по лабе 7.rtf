def aggregate_dd(records, group_field, metric_field):\par
    groups = defaultdict(list)\par
    for record in records:\par
        groups[record[group_field]].append(record[metric_field])\par
    return \{key: \{"count": len(v), "sum": sum(v), "min": min(v),\par
                  "max": max(v), "avg": sum(v) / len(v)\}\par
            for key, v in groups.items()\}\par
