def is_number(value):\par
    """True \'e4\'eb\'ff int \'e8 float, \'ed\'ee \'ed\'e5 \'e4\'eb\'ff bool."""\par
    return type(value) in (int, float)\par
\par
def validate_record(record):\par
    """\'c2\'ee\'e7\'e2\'f0\'e0\'f9\'e0\'e5\'f2 None \'e4\'eb\'ff \'ea\'ee\'f0\'f0\'e5\'ea\'f2\'ed\'ee\'e9 \'e7\'e0\'ef\'e8\'f1\'e8 \'eb\'e8\'e1\'ee \'ea\'ee\'e4 \'ee\'f8\'e8\'e1\'ea\'e8."""\par
    if type(record) is not dict:\par
        return "NOT_DICT"\par
    for key in REQUIRED:\par
        if key not in record:\par
            return "MISSING"\par
    if type(record["id"]) is not str or not record["id"].strip():\par
        return "BAD_ID"\par
    if record["status"] not in ALLOWED_STATUSES:\par
        return "BAD_STATUS"\par
    if not is_number(record["debit"]) or record["debit"] < 0:\par
        return "BAD_DEBIT"\par
    if not is_number(record["water_cut"]):\par
        return "BAD_WATER_CUT"\par
    if not 0 <= record["water_cut"] <= 100:\par
        return "BAD_WATER_CUT"\par
    return None\par
\par
def build_registry(raw):\par
    """\'c2\'ee\'e7\'e2\'f0\'e0\'f9\'e0\'e5\'f2 (\'ea\'ee\'f0\'f0\'e5\'ea\'f2\'ed\'fb\'e5 \'e7\'e0\'ef\'e8\'f1\'e8, \'f1\'ef\'e8\'f1\'ee\'ea \'ee\'f8\'e8\'e1\'ee\'ea \'e2\'e8\'e4\'e0 (\'ed\'ee\'ec\'e5\'f0 \'f1\'f2\'f0\'ee\'ea\'e8, \'ea\'ee\'e4))."""\par
    records, errors, seen = [], [], set()\par
    for index, record in enumerate(raw):\par
        code = validate_record(record)\par
        if code is None and record["id"] in seen:\par
            code = "DUPLICATE"\par
        if code is not None:\par
            errors.append((index, code))\par
            continue\par
        seen.add(record["id"])\par
        records.append(record)\par
    return records, errors\par
\par
def aggregate(records, group_field, metric_field):\par
    """\'c3\'f0\'f3\'ef\'ef\'e8\'f0\'f3\'e5\'f2 \'e7\'e0\'ef\'e8\'f1\'e8 \'ef\'ee \'ef\'ee\'eb\'fe group_field \'e8 \'f1\'f7\'e8\'f2\'e0\'e5\'f2 \'f1\'f2\'e0\'f2\'e8\'f1\'f2\'e8\'ea\'f3 metric_field."""\par
    result = \{\}\par
    for record in records:\par
        key = record[group_field]\par
        bucket = result.get(key)\par
        if bucket is None:\par
            bucket = \{"count": 0, "sum": 0.0,\par
                      "min": record[metric_field], "max": record[metric_field]\}\par
            result[key] = bucket\par
        value = record[metric_field]\par
        bucket["count"] += 1\par
        bucket["sum"] += value\par
        bucket["min"] = min(bucket["min"], value)\par
        bucket["max"] = max(bucket["max"], value)\par
    for bucket in result.values():\par
        bucket["avg"] = bucket["sum"] / bucket["count"]\par
    return result\par
\par
def unique_values(records, field):\par
    """\'cc\'ed\'ee\'e6\'e5\'f1\'f2\'e2\'ee \'f3\'ed\'e8\'ea\'e0\'eb\'fc\'ed\'fb\'f5 \'e7\'ed\'e0\'f7\'e5\'ed\'e8\'e9 \'ef\'ee\'eb\'ff."""\par
    return \{record[field] for record in records\}\par
\par
def ids_where(records, field, allowed):\par
    """\'cc\'ed\'ee\'e6\'e5\'f1\'f2\'e2\'ee id \'e7\'e0\'ef\'e8\'f1\'e5\'e9, \'f3 \'ea\'ee\'f2\'ee\'f0\'fb\'f5 \'e7\'ed\'e0\'f7\'e5\'ed\'e8\'e5 \'ef\'ee\'eb\'ff \'e2\'f5\'ee\'e4\'e8\'f2 \'e2 allowed."""\par
    return \{record["id"] for record in records if record[field] in allowed\}\par
\par
def ids_in_range(records, field, low, high):\par
    """\'cc\'ed\'ee\'e6\'e5\'f1\'f2\'e2\'ee id \'e7\'e0\'ef\'e8\'f1\'e5\'e9, \'f3 \'ea\'ee\'f2\'ee\'f0\'fb\'f5 \'e7\'ed\'e0\'f7\'e5\'ed\'e8\'e5 \'ef\'ee\'eb\'ff \'ef\'ee\'ef\'e0\'e4\'e0\'e5\'f2 \'e2 [low; high]."""\par
    return \{record["id"] for record in records if low <= record[field] <= high\}\par
\par
